# Credentials - never commit these
secrets.h
secrets.yaml
credentials.local.md
# Temporary RoboForm data-entry checklist (contains passwords) -- delete when done
roboform-checklist.local.md
.env
!.env.example
# CARD-0334 Phase 1c: salted hashes of current secrets -- not values, but keep
# workstation-local anyway (weak/guessable secrets aren't meaningfully protected
# by a salt the way a long random token is).
tos/hooks/secret-fingerprints.json
tos/hooks/.secret-salt

# Arduino build artifacts
build/
*.bin
*.elf

# Python build artifacts
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/

# Claude Code local settings and memory (machine-specific)
**/.claude/settings.local.json
**/.claude/memory/

# Hike-izer: extracted photo/video media (CARD-0084) - regenerated from
# Immich on demand, not versioned; only the HTML/Markdown summaries are
hike-izer/summaries/*_photos/

# hike-izer-web: Cloudflare Tunnel credentials - real secrets, generated on
# the M8 by `cloudflared tunnel create`, never tracked. Not currently in use
# (CARD-0088 shipped on Tailscale Funnel instead, see CARD-0094 for the
# deferred switch back to this) - left in place for when that happens.
components/hike-izer-web/cloudflared/

# Node dependencies - installed via npm on whichever host runs the component
node_modules/

# photo-quality-review (CARD-0028): scan report, blur-detection cache, and
# review decisions are all runtime-generated on the M8, not source
components/photo-quality-review/data/
components/photo-quality-review/bin/
