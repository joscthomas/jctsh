# Air Quality Monitor — ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in actual credentials.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "JCTnet1"
wifi_password: "<JCTnet1-wifi-password>"

# Pixel hotspot — second network for field sync without home WiFi.
# Added 2026-08-20: USB charging and solar both trigger dock-detect the same
# way the home dock does, so field connections are a real path now, not just
# a docked/home-only scenario (see JCTsh-air-quality-monitor-phase1.md's
# superseded Timeout/timer logic decision).
hotspot_ssid: "JCT Hotspot"
hotspot_password: "<hotspot-password>"

# Fallback AP — used if WiFi connection fails at boot
ap_password: "<choose-a-fallback-ap-password>"

# OTA update password — used for wireless firmware updates
ota_password: "<choose-an-ota-password>"

# CARD-0377 Phase 2: the data-pipeline gateway's bulk-upload endpoint (M8,
# reached via the public Cloudflare-tunneled route -- works identically
# docked at home or via the Pixel hotspot while traveling). Same API_KEY
# data-pipeline-api's other callers already use. Header value includes the
# "Bearer " prefix already, so it can be referenced directly with no lambda.
data_pipeline_bulk_url: "https://hikes.jctnet.com/data/environmental-data-bulk"
data_pipeline_auth_header: "Bearer <data-pipeline-api-key>"

# CARD-0377 Phase 2 (2026-10-01/02): MQTT dropped entirely -- the
# mqtt_broker/mqtt_username/mqtt_password/mqtt_ca_cert secrets this device
# used to need are gone from air-quality-monitor.yaml, so they're gone from
# here too. See that file's top-of-file comment and CARD-0377 for why.
