[Unit]
Description=CARD-0214: daily hike-summary gap-fill pass (Environmental Data / photos that synced since the first pass)
After=docker.service

[Service]
Type=oneshot
User=jct
# CARD-0258: retries of a failing hike (up to 4, 15 min apart) can push a
# real run past the 90s system default (DefaultTimeoutStartUSec) well
# before it's actually stuck -- 90 min covers the worst case (multiple
# failing hikes' retry rounds) with real headroom.
TimeoutStartSec=5400
ExecStart=/usr/bin/docker exec hike-izer-orchestrator python3 generation.py --daily-refresh
