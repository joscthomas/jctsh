# Template -- copy to .env in this same directory on the M8
# (~/hike-izer-web-app/.env) and fill in the real values. Never commit the
# real .env. See credentials.local.md for the actual generated/real values.

# CARD-0086 stage 1: shared secret the Tasker profile includes as
# ?key=<value> on its webhook POST. The orchestrator rejects any request
# with a missing or incorrect key.
WEBHOOK_SECRET=

# CARD-0086 stage 2: narrative generation.
ANTHROPIC_API_KEY=

# Same Apps Script deployment fetch_hike_data.py already uses interactively
# -- see credentials.local.md "Google Apps Script -- Environmental Data
# Pipeline".
APPS_SCRIPT_URL=
APPS_SCRIPT_KEY=

# Same Immich instance fetch_hike_photos.py already uses interactively --
# see credentials.local.md "Immich (Docker, on photo-server)". Use Joseph's
# key, not Robin's.
IMMICH_URL=
IMMICH_KEY=

# Dedicated Mosquitto account (per CLAUDE.md's "Future Components"
# convention) for the jctsh/hike-izer/publish/log visibility line.
MQTT_USERNAME=
MQTT_PASSWORD=

# CARD-0134: basemap tiles for the Route Map (CARD-0082), read by
# generation.py and passed into templating.render_html(). Same key value
# as credentials.local.md's "Thunderforest (hike-izer Route Map basemap
# tiles, CARD-0082)" entry. Missing/empty just omits the Route Map
# section, not a generation failure.
THUNDERFOREST_API_KEY=

# CARD-0141: ha_notify.py's push notification on hike-summary publish
# success/failure. Same HA_TOKEN reused across Node-RED and photo-tv-display
# -- see credentials.local.md "Home Assistant" long-lived access token entry.
HA_TOKEN=
HA_URL=

# CARD-0174: reference-call speaker icon (Wildlife Heard table + Life List),
# via xeno_canto.py. Free account, xeno-canto.org's own Account Page -- see
# credentials.local.md "Xeno-canto" entry. Missing/empty just omits the
# speaker icon, not a generation failure.
XENO_CANTO_API_KEY=

# CARD-0173: /webhook/idea's direct-to-kanban-PR path (Tasker voice capture
# -> open_kanban_pr.open_finding_pr(), no email in between). Same GitHub PAT
# this M8's own host-level maintenance-check.py already has at
# /etc/jctsh/github.env -- see credentials.local.md "GitHub PAT" entry.
# Missing/empty only breaks that one endpoint.
GITHUB_PAT=
