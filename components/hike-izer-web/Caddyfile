:80 {
    # CARD-0136: access logging to stdout was missing entirely -- found
    # while tracing an unexplained duplicate /webhook/hike-end POST and
    # discovering there was no way to tell whether it came through this
    # public path at all. `format console` (not Caddy's default JSON) so
    # it reads the same way as `docker logs` on every other container in
    # this stack -- one grep-able line per request, source IP included.
    log {
        output stdout
        format console
    }

    # CARD-0086: webhook receiver, reached at
    # https://photo-server.tailfe828a.ts.net/webhook/hike-end -- proxied to
    # the `orchestrator` service (same compose project, reachable by
    # service name on the project's default Docker network). Must come
    # before the catch-all file_server block below.
    handle /webhook/* {
        reverse_proxy orchestrator:8080
    }

    # CARD-0349 Phase 1: the TimescaleDB gateway (core/data-pipeline/),
    # a separate compose project (`data-pipeline`) on this same M8 --
    # reachable here because `web` also joins that project's own default
    # network (docker-compose.yml's `data-pipeline_default: external: true`),
    # same "Docker Compose supports one container joining a second
    # project's network by name" mechanism already used for `/webhook/*`
    # above, just across projects instead of within one. `handle_path`
    # (not `handle`) strips the /data prefix -- the gateway's own routes
    # are /environmental-data, /gps, etc., not /data/environmental-data.
    handle_path /data/* {
        reverse_proxy data-pipeline-api:8080
    }

    handle {
        root * /srv/hike-izer
        file_server browse
    }
}
