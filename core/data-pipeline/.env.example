# Template -- copy to .env in this same directory on the M8
# (~/data-pipeline-app/.env) and fill in the real values. Never commit the
# real .env. See credentials.local.md for the actual generated/real values
# once set (CARD-0349, Step 1).

# Postgres password -- read by both services (timescaledb via
# POSTGRES_PASSWORD, data-pipeline-api via DB_PASSWORD), same env_file
# pattern as every other multi-service compose project here
# (hike-izer-web-app).
POSTGRES_PASSWORD=
DB_PASSWORD=

# Shared secret every route checks via ?key= -- same pattern as today's
# Apps Script (environmental-data.gs's own API_KEY Script Property).
API_KEY=

# CARD-0372: rotation window. Leave both UNSET normally. During a rotation the
# runner moves the old key to API_KEY_PREVIOUS and sets an expiry; the gateway
# accepts either key until that instant and then ignores the old one on its
# own. A previous key without a valid expiry is ignored.
#   API_KEY_PREVIOUS=<old key>
#   API_KEY_PREVIOUS_EXPIRES=2026-10-13T19:00:00Z   # ISO 8601 UTC or epoch seconds

# CARD-0349 Phase 2: same value as hike-izer-orchestrator's own
# WEBHOOK_SECRET (credentials.local.md) -- this container has no MQTT
# client of its own, so GPS Track/Hike Start Forecast/Wildlife Detections
# dashboard visibility goes through hike-izer-orchestrator's
# /webhook/pipeline-log relay, authenticated with the same secret.
WEBHOOK_SECRET=
